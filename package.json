{
  "name": "glass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include './src/site/**' --include './src/shared/**' --include './src/locales/**' --include './src/engine/**' src/server/index.ts",
    "build": "tsx scripts/cli.ts build",
    "build:console": "vite build --config vite.config.ts",
    "preview": "wrangler pages dev dist --port 4173",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "content:new": "tsx scripts/cli.ts new",
    "schedule:run": "tsx scripts/cli.ts schedule",
    "skills:check": "tsx scripts/check-skills.ts",
    "i18n:extract": "tsx scripts/ui-catalog.ts --write",
    "i18n:check": "tsx scripts/ui-catalog.ts",
    "start": "tsx src/server/index.ts --production",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "quality:report": "tsx scripts/report-assets.ts",
    "quality:readers": "tsx scripts/benchmark-readers.ts",
    "quality:workspace": "tsx --tsconfig tsconfig.json scripts/benchmark-workspace.ts",
    "quality:editor": "tsx scripts/benchmark-editor.ts",
    "quality:backups": "node --max-old-space-size=256 --import tsx scripts/benchmark-backups.ts",
    "renderers:install": "playwright install chromium",
    "markdown:check": "tsx scripts/authoring.ts check",
    "authoring:pack": "tsx scripts/authoring.ts pack",
    "authoring:docs": "tsx scripts/authoring-reference.ts",
    "aca:dev": "wrangler dev --config infrastructure/aca/wrangler.jsonc --local --port 4390 --test-scheduled",
    "aca:migrate:local": "wrangler d1 migrations apply glass-aca --local --config infrastructure/aca/wrangler.jsonc",
    "aca:deploy": "tsx scripts/services.ts aca",
    "dynamic:snapshot": "tsx scripts/dynamic-snapshot.ts",
    "dynamic:build": "npm run dynamic:snapshot && npm --prefix apps/dynamic run build",
    "dynamic:check": "npm --prefix apps/dynamic run check",
    "dynamic:security": "vitest run --config vitest.dynamic.config.ts",
    "dynamic:test": "npm run dynamic:security && tsx scripts/test-dynamic.ts",
    "services:check": "tsx scripts/services.ts check",
    "dynamic:deploy": "tsx scripts/services.ts dynamic",
    "mcp": "tsx scripts/mcp.ts",
    "doctor": "tsx scripts/doctor.ts",
    "cloud:build:studio": "tsx scripts/cloud-build.ts studio",
    "cloud:build:site": "tsx scripts/cloud-ci.ts",
    "cloud:deploy:studio": "tsx scripts/cloud-deploy.ts studio",
    "cloud:deploy:site": "tsx scripts/cloud-deploy.ts site",
    "cloud:preview:studio": "tsx scripts/cloud-preview.ts studio",
    "cloud:preview:site": "tsx scripts/cloud-preview.ts site",
    "cloud:export": "tsx scripts/cloud-migrate.ts export",
    "cloud:import": "tsx scripts/cloud-import.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@cfworker/json-schema": "4.1.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@expressive-code/plugin-line-numbers": "0.44.3",
    "@hono/node-server": "2.1.5",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "aws4fetch": "1.0.20",
    "buffer": "6.0.3",
    "codemirror": "6.0.2",
    "decode-named-character-reference": "1.3.0",
    "echarts": "6.1.0",
    "exif-reader": "2.0.3",
    "expressive-code": "0.44.3",
    "giscus": "1.6.0",
    "globe.gl": "2.46.2",
    "hono": "4.13.13",
    "jose": "6.1.3",
    "jsonc-parser": "3.2.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "mermaid": "12.2.0",
    "micromark-util-types": "2.0.3",
    "pagefind": "1.5.2",
    "photoswipe": "5.4.4",
    "playwright": "1.64.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-definition-list": "2.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tar-stream": "3.2.2",
    "three": "0.186.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "web-vitals": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/hast": "3.0.5",
    "@types/leaflet": "1.9.21",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "miniflare": "5.20261012.1-beta",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "katex": "0.18.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lapotron/Glass.git"
  },
  "bugs": {
    "url": "https://github.com/Lapotron/Glass/issues"
  },
  "homepage": "https://github.com/Lapotron/Glass#readme"
}
